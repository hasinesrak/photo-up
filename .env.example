# PhotoUp stack configuration — copy to `.env` and fill in real values.
# Used for LOCAL development only (`docker compose up`).
# In CI/CD, every secret below is injected from GitHub Actions secrets:
#   MYSQL_ROOT_PASSWORD · MYSQL_PASSWORD · JWT_SECRET · DOCKERHUB_USERNAME · DOCKERHUB_TOKEN
# (repo → Settings → Secrets and variables → Actions)

# Docker Hub namespace used to tag the app image for pushing.
DOCKERHUB_NAMESPACE=your-dockerhub-username

# MySQL credentials (used by the db service and the app)
MYSQL_DATABASE=photoup
MYSQL_USER=photoup
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# Secret used to sign JWT session tokens
JWT_SECRET=change-me-long-random-string
